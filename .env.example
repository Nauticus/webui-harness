# These values seed the built-in "default" provider on first run (only when no
# providers exist yet). After that, add/edit providers (with their own base URL
# and API key) in the UI via the 🔌 button in the header.
#
# OpenAI:      leave OPENAI_BASE_URL unset, use your key
# Ollama:      OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama
# OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1

OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
# Model used only as a last resort (when the project has no model AND the provider
# has no detected models). Usually leave this unset.
OPENAI_MODEL=

# Sandbox directory the agent's shell/file tools are confined to
AGENT_WORKSPACE_DIR=./workspace

# Server port
PORT=3001

# Base dir for the SQLite DB, history files and the encryption key (default: <repo>/data)
# WEBLISAN_DATA_DIR=./data
# Fine-grained override for just the SQLite file (default: <dataDir>/weblisan.db)
# WEBLISAN_DB=./data/weblisan.db

# 64-hex history encryption key. Auto-generated on first run (saved to data/key
# and appended to this file). Set explicitly to use your own key.
# WEBLISAN_KEY=

# Context compaction. When the estimated context exceeds
# COMPACT_CONTEXT_WINDOW - COMPACT_RESERVE_TOKENS, the old part of the
# conversation is summarized (one extra LLM call with the session's model) and
# re-injected as a summary; only the last COMPACT_KEEP_RECENT_TOKENS stay
# verbatim. Tune the window to your model's real context size.
# COMPACT_CONTEXT_WINDOW=128000
# COMPACT_RESERVE_TOKENS=16384
# COMPACT_KEEP_RECENT_TOKENS=20000
